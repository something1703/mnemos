# Where the deployed Mnemos API lives. `make deploy-api` prints it.
MNEMOS_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# A READ-scoped key. Never shipped to the browser — the console reads it only
# in server components and route handlers.
#   mnemos-api mint-key --tenant <slug> --scope read --label console
MNEMOS_API_KEY_READ=

# No admin key here on purpose. Phase 08.3: the admin key is re-entered inside
# the Forget and Revoke flows and never persisted anywhere.

# Per-tenant read keys — the tenant switcher (Phase 08.3). The API derives the
# tenant from the key and has no tenant path parameter, so switching tenants
# means presenting a different credential and the isolation a judge sees is
# the real thing. Any subset may be set; the switcher lists what it has.
#   mnemos-api mint-key --tenant clinic --scope read --label "console read - clinic"
MNEMOS_API_KEY_READ_CLINIC=
MNEMOS_API_KEY_READ_OPS=
MNEMOS_API_KEY_READ_FINANCE=
