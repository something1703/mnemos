{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnConfigSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:582054875648:secret:mnemos/sleep-cycle-*"
    },
    {
      "Sid": "EmitConsolidationHeartbeat",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "Mnemos/SleepCycle" }
      }
    }
  ]
}
