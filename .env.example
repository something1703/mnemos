# Mnemos — local environment template.
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# In deployed environments these come from AWS Secrets Manager, not from a file.

# ---------------------------------------------------------------------------
# CockroachDB
# ---------------------------------------------------------------------------
# Cloud cluster (Phase 02). Must use sslmode=verify-full with the CA cert at
#   $HOME/.postgresql/root.crt
# Download once:
#   curl --create-dirs -o $HOME/.postgresql/root.crt \
#     'https://cockroachlabs.cloud/clusters/<CLUSTER_ID>/cert'
MNEMOS_DB_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full

# The two role-bound logins the DEPLOYED service uses (infra/api/deploy.sh).
#
# MNEMOS_DB_URL above is the admin login, because migrations and seeding need
# DDL. The deployment must not have it: invariant 1 says no LLM-driven process
# holds DELETE, and the only way to mean that is for the cluster to refuse.
#
#   CREATE USER mnemos_api_svc WITH PASSWORD '...';
#   GRANT mnemos_api TO mnemos_api_svc;          -- no DELETE anywhere
#   CREATE USER mnemos_warden_svc WITH PASSWORD '...';
#   GRANT mnemos_warden TO mnemos_warden_svc;    -- DELETE, behind an admin scope
#
# GET /health reports the measured result, so a misconfiguration here is
# visible rather than assumed:
#   "privilege_separation": true, "source": "measured", "api_can_delete": false
#
# sslrootcert=system is appended automatically at deploy time — psycopg[binary]
# bundles an OpenSSL whose default CA path does not exist in the Lambda image.
MNEMOS_DB_URL_API=postgresql://mnemos_api_svc:<password>@<host>:26257/mnemos?sslmode=verify-full
MNEMOS_DB_URL_WARDEN=postgresql://mnemos_warden_svc:<password>@<host>:26257/mnemos?sslmode=verify-full

# The sleep cycle's role-bound login (infra/sleep-cycle/deploy.sh). Same
# reasoning: everything this service writes lands 'unverified' regardless of
# how confident the model claims to be (Phase 05.4), and it holds no DELETE
# grant either way — decay lowers strength, it never removes a row.
#   CREATE USER mnemos_pipeline_svc WITH PASSWORD '...';
#   GRANT mnemos_pipeline TO mnemos_pipeline_svc;   -- BYPASSRLS, no DELETE
MNEMOS_DB_URL_PIPELINE=postgresql://mnemos_pipeline_svc:<password>@<host>:26257/mnemos?sslmode=verify-full

# The Custodian's own direct connection (Phase 07.3/07.4) — custodian_runs/
# custodian_findings/governance_proposals bookkeeping only. No grant on
# episodic_events/semantic_facts at all; it writes memory exclusively
# through MNEMOS_API_KEY_CUSTODIAN's write-scoped remember() calls below.
#   CREATE USER mnemos_readonly_svc WITH PASSWORD '...';
#   GRANT mnemos_readonly TO mnemos_readonly_svc;   -- no DELETE, no BYPASSRLS
MNEMOS_DB_URL_CUSTODIAN=postgresql://mnemos_readonly_svc:<password>@<host>:26257/mnemos?sslmode=verify-full

# Local single-node Docker cluster (`make db-local`) — used by CI and unit tests.
MNEMOS_DB_URL_LOCAL=postgresql://root@localhost:26257/mnemos?sslmode=disable

# Local 9-node, 3-locality rig (`make db-multiregion`) — residency + node-kill demos.
MNEMOS_DB_URL_RIG=postgresql://root@localhost:26357/mnemos?sslmode=disable

# ---------------------------------------------------------------------------
# CockroachDB Cloud control plane (Phase 07 — Custodian)
# ---------------------------------------------------------------------------
# Cluster ID is an identifier, not a credential; it is also committed in
# .mcp.json so the repo works out of the box. Access still requires OAuth or a
# service-account API key, which live only here and in Secrets Manager.
COCKROACH_MCP_CLUSTER_ID=244bd64e-3168-4d39-a467-efad02a4dcb0
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp

# Service account for the Custodian, used by tests/custodian/
# test_mcp_client_live.py and (eventually) the deployed sweep loop.
#
# Honest limit, not a mistake: no CockroachDB Cloud IAM role short of
# Cluster Admin unlocks the MCP server's SQL tools for a service account at
# all (Cluster Monitor and Cluster Developer both blocked every SQL-shaped
# tool outright, tested 2026-08-09 against the real cluster) — so this key
# genuinely can call create_database/create_table/insert_rows if asked.
# Invariant 1's "no LLM-driven process holds destructive privileges" holds
# here at the APPLICATION layer instead: mnemos_custodian.allowlist never
# maps any skill to a write-capable tool, and CustodianMcpClient.call_tool()
# independently refuses to invoke one by name regardless of what any
# allowlist entry says. See docs/limits.md's "The Custodian's credential is
# not platform-enforced read-only" for the full account.
COCKROACH_SERVICE_ACCOUNT_KEY_CUSTODIAN=

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_PROFILE=default
AWS_REGION=us-east-1

# Simulated jurisdictions for residency demos. These are locality labels on the
# local 9-node rig; they cost nothing and deploy nowhere.
MNEMOS_REGIONS=us-east-1,eu-central-1,ap-south-1

# ---------------------------------------------------------------------------
# Model provider (Phase 05). Provider-agnostic by design — see ADR-014.
# ---------------------------------------------------------------------------
# The sleep cycle is the ONLY component that may call a model; the Warden must
# never be able to (invariant 1). Which vendor it calls is a config choice, and
# the poisoning-resistance tests run against whichever is configured — so
# "resistant to memory poisoning" is not secretly a claim about one vendor.
MNEMOS_MODEL_PROVIDER=openai

OPENAI_API_KEY=

# MUST produce 1024 dimensions to match VECTOR(1024) without a migration.
# text-embedding-3-small accepts a `dimensions` parameter, so 1024 is exact.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1024

# Resolved against the live /v1/models list rather than hardcoded — run
# `uv run python scripts/pick_model.py` to see what your key can actually
# reach and what it costs.
OPENAI_DISTILL_MODEL=

# The Custodian's interpretation model (Phase 07.3) — same provider as
# distillation above (this project's own pivot from Bedrock), defaults to
# OPENAI_DISTILL_MODEL if unset rather than requiring a second decision.
OPENAI_CUSTODIAN_MODEL=

# Hard spend guard: the sleep cycle refuses a run that would exceed this.
MNEMOS_MODEL_BUDGET_USD=5.00
MNEMOS_MAX_TOKENS_PER_RUN=200000

# Bedrock (alternate provider, same interface — ADR-014)
BEDROCK_REGION=us-east-1
BEDROCK_DISTILL_MODEL=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# KMS envelope encryption + crypto-shred (Phase 02.4 / 06.4).
# One CMK per tenant (arn:aws:kms:<region>:<account>:key/<id>). Only create
# these with explicit approval of the key policy — see ADR-013.
MNEMOS_KMS_KEY_ARN_CLINIC=
MNEMOS_KMS_KEY_ARN_OPS=
MNEMOS_KMS_KEY_ARN_FINANCE=

# S3: artifacts, and the Object Lock (compliance mode) bucket that anchors
# Merkle roots. The Object Lock bucket is WORM — objects genuinely cannot be
# deleted until retention expires, verified empirically in ADR-013. Create it
# only with explicit approval.
MNEMOS_S3_ARTIFACTS_BUCKET=
MNEMOS_S3_ANCHOR_BUCKET=
MNEMOS_ANCHOR_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Mnemos API (Phase 04)
# ---------------------------------------------------------------------------
# Where the API is reachable. `make deploy-api` prints the deployed value.
MNEMOS_API_URL=http://localhost:8000

# Host headers the MCP transport will accept. The SDK answers 421 "Invalid Host
# header" to anything else — DNS rebinding protection, which is worth keeping.
# Loopback is always allowed; this is for the deployed hostname. Comma
# separated. A literal "*" disables the check entirely.
MNEMOS_ALLOWED_HOSTS=

# CockroachDB connections one process may hold. Defaults to 8 locally and 2
# under Lambda, where pool size multiplies by however much concurrency the
# platform decides to grant.
MNEMOS_DB_POOL_MAX=
MNEMOS_API_KEY_READ=
MNEMOS_API_KEY_WRITE=
MNEMOS_API_KEY_ADMIN=

# The Custodian's own write-scoped key (Phase 07.3) — deliberately its own
# credential, not a shared MNEMOS_API_KEY_WRITE, so a compromised Custodian
# key is not the same credential anything else in the demo relies on.
# Minted via: mnemos-api mint-key --tenant <slug> --scope write --label custodian-sweep
MNEMOS_API_KEY_CUSTODIAN=
MNEMOS_CUSTODIAN_TENANT_SLUG=

# Ledger tuning (Phase 02.5). Shard count is the audit-chain throughput knob;
# the scaling curve is published in docs/scale.md.
MNEMOS_CHAIN_SHARDS=16
MNEMOS_CHECKPOINT_INTERVAL_MINUTES=60
